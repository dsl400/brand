#!/usr/bin/env python3
"""brand-lint — find the values in code that the brand tokens do not hold.

Usage: brand-lint [<path> ...] --workspace <dir> [--json]

Reads <workspace>/docs/brand/tokens.json. With no path, scans the workspace.
In a git repository, scans the tracked and untracked files that .gitignore
does not exclude. Reports one finding per line: path:line:col — RULE — message

Exit status: 0 with no finding, 1 with a finding, 2 when tokens.json is absent
or invalid, or a path lies outside the workspace. A line that holds the text
"brand-lint: allow" is skipped.

Rules:
  BL-COLOR   a hex, rgb(), hsl(), or named color outside the palette
  BL-FONT    a font family outside the typography: CSS, the font shorthand,
             SVG attributes, fontFamily in JS, Google Fonts URLs, font-[...]
  BL-RADIUS  a corner radius other than corner_radius_px: CSS, borderRadius
             in JS, rounded-[...]
  BL-NAME    the ASCII form of the name, in any letter case

Out of reach (brand-check reviews these by reading): oklch(), lab(),
color-mix(), named Tailwind classes such as rounded-lg or text-blue-500,
values built at runtime, and binary files (PNG, PDF, Office).
"""
import argparse
import colorsys
import json
import re
import subprocess
import sys
from bisect import bisect_right
from pathlib import Path

TOKENS = "docs/brand/tokens.json"
ALLOW_MARK = "brand-lint: allow"

# The file types that hold colors, fonts, or visible text.
EXTENSIONS = {
    ".css", ".scss", ".sass", ".less", ".html", ".htm", ".svg", ".js", ".jsx",
    ".mjs", ".cjs", ".ts", ".tsx", ".vue", ".svelte", ".astro", ".md", ".mdx",
    ".json", ".yml", ".yaml", ".txt",
}

# In these files each hex literal outside an id or a link is a color. In the
# other files a hex is a color only after a color key on the same line,
# because "#123" there is often an issue, an anchor, or an id.
STYLE_EXT = {".css", ".scss", ".sass", ".less", ".html", ".htm", ".svg",
             ".vue", ".svelte", ".astro"}

# A folder with one of these names holds code that the project does not
# write, at any depth, so a monorepo scans only its own sources.
SKIP_DIRS = {".git", "node_modules", "dist", "build", ".next", ".nuxt", "out",
             "coverage", "vendor", ".venv", "venv", "__pycache__", ".turbo",
             ".svelte-kit", ".astro"}

# docs/brand/ is the source of the tokens, so it agrees by construction.
# reports/ holds the findings, which quote the deviations.
SKIP_ROOT = ("docs/brand/", "reports/")
SKIP_FILES = re.compile(r"(\.min\.\w+|package-lock\.json|pnpm-lock\.yaml|yarn\.lock)$")

# A generic family or a CSS-wide keyword names no typeface.
GENERIC_FONTS = {
    "serif", "sans-serif", "monospace", "cursive", "fantasy", "system-ui",
    "ui-serif", "ui-sans-serif", "ui-monospace", "ui-rounded", "math",
    "emoji", "fangsong", "inherit", "initial", "unset", "revert",
    "revert-layer", "-apple-system", "blinkmacsystemfont",
}
CSS_WIDE = {"inherit", "initial", "unset", "revert", "revert-layer"}
DYNAMIC = re.compile(r"var\(|\$\{|\$\w|theme\(|calc\(|clamp\(|min\(|max\(|env\(")

NAMED_COLORS = set("""
aliceblue antiquewhite aqua aquamarine azure beige bisque black blanchedalmond
blue blueviolet brown burlywood cadetblue chartreuse chocolate coral
cornflowerblue cornsilk crimson cyan darkblue darkcyan darkgoldenrod darkgray
darkgreen darkgrey darkkhaki darkmagenta darkolivegreen darkorange darkorchid
darkred darksalmon darkseagreen darkslateblue darkslategray darkslategrey
darkturquoise darkviolet deeppink deepskyblue dimgray dimgrey dodgerblue
firebrick floralwhite forestgreen fuchsia gainsboro ghostwhite gold goldenrod
gray green greenyellow grey honeydew hotpink indianred indigo ivory khaki
lavender lavenderblush lawngreen lemonchiffon lightblue lightcoral lightcyan
lightgoldenrodyellow lightgray lightgreen lightgrey lightpink lightsalmon
lightseagreen lightskyblue lightslategray lightslategrey lightsteelblue
lightyellow lime limegreen linen magenta maroon mediumaquamarine mediumblue
mediumorchid mediumpurple mediumseagreen mediumslateblue mediumspringgreen
mediumturquoise mediumvioletred midnightblue mintcream mistyrose moccasin
navajowhite navy oldlace olive olivedrab orange orangered orchid palegoldenrod
palegreen paleturquoise palevioletred papayawhip peachpuff peru pink plum
